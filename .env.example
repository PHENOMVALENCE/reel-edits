# Copy to .env.local for development. In production, set these in your host's secret store
# (e.g. Vercel Project Settings > Environment Variables). Never prefix them with NEXT_PUBLIC_.

# --- Claude (pick one) -------------------------------------------------------
# A Claude Console API key (console.anthropic.com > API keys).
ANTHROPIC_API_KEY=
# Or Workload Identity Federation (short-lived tokens, no long-lived key on the server):
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=
# ANTHROPIC_IDENTITY_TOKEN_FILE=/var/run/secrets/token
# ANTHROPIC_SERVICE_ACCOUNT_ID=
# ANTHROPIC_WORKSPACE_ID=

# Default model and optional allow-list (comma separated).
REEL_CLAUDE_MODEL=claude-opus-5-5
# REEL_CLAUDE_ALLOWED_MODELS=claude-opus-5-5,claude-sonnet-5-5
# REEL_CLAUDE_MAX_RETRIES=3
# REEL_CLAUDE_FALLBACKS=off   # disable server-side refusal fallbacks

# --- Transcription (optional) -------------------------------------------------
# Whisper API:
# OPENAI_API_KEY=
# Local whisper.cpp server (free, private):
# WHISPER_CPP_URL=http://127.0.0.1:8080
# REEL_TRANSCRIPTION_PROVIDER=openai-whisper   # or whisper-cpp / none

# --- Budgets and limits --------------------------------------------------------
REEL_BUDGET_MONTHLY_USD=20
REEL_BUDGET_PROJECT_USD=2
REEL_BUDGET_WARN_AT=0.8
REEL_MAX_AUDIO_MINUTES_MONTHLY=120
# Users can change budgets in the app, but never above this:
REEL_BUDGET_HARD_CAP_USD=50
# REEL_MAX_OUTPUT_TOKENS=32000
# REEL_MAX_FRAMES=64

# --- Access and storage --------------------------------------------------------
# App password for the AI routes. Required in production unless REEL_ALLOW_OPEN_API=1.
REEL_ACCESS_TOKEN=
# Usage ledger location (defaults to .data/usage.json; /tmp on Vercel, which is not durable).
# REEL_USAGE_FILE=/data/reel-usage.json
